# Copy to the ignored file .env.sandbox and replace placeholders.
# This file is a template only; never put production values here.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-random-local-only-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_TENANT_ROUTING_MODE=path
DB_CONN_MAX_AGE=0
POSTGRES_SSLMODE=require

# Use a separate Supabase TEST project connection string in session mode
# (port 5432) or a direct PostgreSQL connection. Do not use production or
# transaction-pooler (port 6543) credentials.
DATABASE_URL=postgresql://test_user:replace-me@db-host.invalid:5432/postgres?sslmode=require
